<Window x:Class="ClaudeVoice.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ClaudeVoice"
        Icon="pack://application:,,,/assets/icon.ico"
        Width="320" Height="560"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResize"
        MinWidth="240"
        Topmost="True"
        ShowInTaskbar="True"
        Left="100" Top="100">

  <Window.Effect>
    <DropShadowEffect Color="Black" BlurRadius="20" ShadowDepth="0" Opacity="0.7"/>
  </Window.Effect>

  <!-- Outer border gives rounded corners -->
  <Border Background="{StaticResource BgBrush}"
          CornerRadius="12"
          BorderBrush="#2a2a4a"
          BorderThickness="1">
    <!-- Viewbox scales the whole 320-wide design uniformly as the window resizes.
         RootGrid's height is set in code to fit the content (it changes when the
         hotkey list is expanded or collapsed). -->
    <Viewbox Stretch="Uniform">
    <Grid x:Name="RootGrid" Width="320">
      <Grid.RowDefinitions>
        <RowDefinition Height="40"/>   <!-- drag bar -->
        <RowDefinition Height="*"/>    <!-- content -->
      </Grid.RowDefinitions>

      <!-- ── Drag bar ── -->
      <Border Grid.Row="0"
              Background="#0d0d1e"
              CornerRadius="12,12,0,0"
              MouseLeftButtonDown="DragBar_MouseDown">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>

          <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0">
            <Ellipse Width="8" Height="8" Fill="{StaticResource AccentBrush}" Margin="0,0,6,0"/>
            <TextBlock Text="Claude Voice"
                       Foreground="{StaticResource TextBrush}"
                       FontSize="12" FontWeight="SemiBold"
                       VerticalAlignment="Center"/>
          </StackPanel>

          <Button Grid.Column="1" Content="─"
                  Style="{StaticResource ChromeButtonStyle}"
                  Click="MinimiseButton_Click"
                  ToolTip="Minimise"/>
          <Button Grid.Column="2" Content="✕"
                  Style="{StaticResource ChromeButtonStyle}"
                  Click="CloseButton_Click"
                  ToolTip="Close"/>
        </Grid>
      </Border>

      <!-- ── Main content ── -->
      <StackPanel Grid.Row="1" Margin="12">

        <!-- Speak button -->
        <Border Margin="0,8,0,12" CornerRadius="8" Padding="2">
          <Button x:Name="SpeakButton"
                  Height="90"
                  Background="#0f3460"
                  BorderBrush="#1a4a80"
                  BorderThickness="2"
                  PreviewMouseLeftButtonDown="SpeakButton_MouseDown"
                  PreviewMouseLeftButtonUp="SpeakButton_MouseUp">
            <Button.Template>
              <ControlTemplate TargetType="Button">
                <Border x:Name="Bd"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="8">
                  <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <ControlTemplate.Triggers>
                  <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Bd" Property="Background" Value="#1a4a80"/>
                  </Trigger>
                  <Trigger Property="IsPressed" Value="True">
                    <Setter TargetName="Bd" Property="Background" Value="#0a2040"/>
                  </Trigger>
                </ControlTemplate.Triggers>
              </ControlTemplate>
            </Button.Template>
            <StackPanel HorizontalAlignment="Center">
              <TextBlock x:Name="SpeakIcon" Text="🎤" FontSize="28" HorizontalAlignment="Center"/>
              <TextBlock x:Name="SpeakLabel" Text="SPEAK"
                         Foreground="{StaticResource AccentBrush}"
                         FontSize="14" FontWeight="Bold"
                         HorizontalAlignment="Center" Margin="0,2,0,0"/>
              <TextBlock x:Name="SpeakStatus" Text="Ready"
                         Foreground="{StaticResource SubtextBrush}"
                         FontSize="11" HorizontalAlignment="Center"/>
            </StackPanel>
          </Button>
        </Border>

        <!-- Separator -->
        <Border Height="1" Background="#2a2a4a" Margin="0,0,0,8"/>

        <!-- Link: the one terminal Claude Voice speaks for and types into -->
        <TextBlock x:Name="LinkStatus" Text="Not linked"
                   Foreground="{StaticResource SubtextBrush}"
                   FontSize="11" TextAlignment="Center"
                   TextTrimming="CharacterEllipsis"
                   Margin="0,0,0,6"/>
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="6"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <!-- Spans both columns while not linked (Unlink hidden) -->
          <Button x:Name="LinkButton" Grid.Column="0" Grid.ColumnSpan="3"
                  Content="Link terminal"
                  Style="{StaticResource ActionButtonStyle}"
                  Click="LinkButton_Click"/>
          <Button x:Name="UnlinkButton" Grid.Column="2"
                  Content="Unlink"
                  Style="{StaticResource ActionButtonStyle}"
                  Click="UnlinkButton_Click"
                  Visibility="Collapsed"/>
        </Grid>

        <!-- Notices: TTS errors, headset status (fixed two-line area so the layout never jumps) -->
        <TextBlock x:Name="StatusMessage"
                   Foreground="{StaticResource AccentBrush}"
                   FontSize="10" TextAlignment="Center"
                   TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                   Height="28" Margin="0,4,0,4"/>

        <!-- Separator -->
        <Border Height="1" Background="#2a2a4a" Margin="0,0,0,10"/>

        <!-- TTS toggle -->
        <Grid Margin="0,0,0,8">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <TextBlock Grid.Column="0" Text="Voice"
                     Foreground="{StaticResource SubtextBrush}"
                     FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
          <ToggleButton x:Name="TtsToggle" Grid.Column="1"
                        HorizontalAlignment="Center"
                        Width="50" Height="24"
                        Checked="TtsToggle_Checked"
                        Unchecked="TtsToggle_Unchecked"
                        Template="{StaticResource ToggleSwitchTemplate}"/>
          <TextBlock x:Name="TtsStatusLabel" Grid.Column="2"
                     Text="ON" Foreground="{StaticResource AccentBrush}"
                     FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
        </Grid>

        <!-- Speed control -->
        <Grid Margin="0,0,0,12">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <TextBlock Grid.Column="0" Text="Speed"
                     Foreground="{StaticResource SubtextBrush}"
                     FontSize="11" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,8,0"/>
          <Button Grid.Column="1" Content="−" HorizontalAlignment="Left"
                  Style="{StaticResource SpeedButtonStyle}" Click="SlowDown_Click"/>
          <TextBlock x:Name="RateLabel" Grid.Column="2"
                     Text="+0%" Foreground="{StaticResource TextBrush}"
                     FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"
                     MinWidth="36" TextAlignment="Center"/>
          <Button Grid.Column="3" Content="+" HorizontalAlignment="Right"
                  Style="{StaticResource SpeedButtonStyle}" Click="SpeedUp_Click"/>
        </Grid>

        <!-- Action buttons -->
        <Grid Margin="0,0,0,10">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="6"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <Button Grid.Column="0" Content="▶  Replay"
                  Style="{StaticResource ActionButtonStyle}"
                  Click="ReRead_Click"/>
          <Button Grid.Column="2" Content="⏹  Stop"
                  Style="{StaticResource ActionButtonStyle}"
                  Click="Stop_Click"/>
        </Grid>

        <!-- Separator -->
        <Border Height="1" Background="#2a2a4a" Margin="0,0,0,4"/>

        <!-- Hotkey reference — collapsed by default, click the header to expand -->
        <Button x:Name="HotkeysToggle" Click="HotkeysToggle_Click"
                Cursor="Hand" HorizontalContentAlignment="Left"
                Foreground="{StaticResource SubtextBrush}">
          <Button.Template>
            <ControlTemplate TargetType="Button">
              <Border x:Name="Bd" Background="Transparent" CornerRadius="4" Padding="2,4">
                <ContentPresenter/>
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="Bd" Property="Background" Value="#2a2a4a"/>
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Button.Template>
          <TextBlock x:Name="HotkeysToggleLabel" Text="▸  HOTKEYS"
                     FontSize="10" FontWeight="Bold"/>
        </Button>
        <Grid x:Name="HotkeysPanel" Visibility="Collapsed" Margin="0,4,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="120"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="18"/>
            <RowDefinition Height="18"/>
            <RowDefinition Height="18"/>
            <RowDefinition Height="18"/>
            <RowDefinition Height="18"/>
            <RowDefinition Height="18"/>
            <RowDefinition Height="18"/>
            <RowDefinition Height="18"/>
            <RowDefinition Height="18"/>
          </Grid.RowDefinitions>

          <TextBlock Grid.Row="0" Grid.Column="0" Text="Ctrl+Space"       Foreground="{StaticResource AccentBrush}"  FontSize="10" FontFamily="Consolas"/>
          <TextBlock Grid.Row="0" Grid.Column="1" Text="Record / stop recording" Foreground="{StaticResource TextBrush}" FontSize="10"/>

          <TextBlock Grid.Row="1" Grid.Column="0" Text="Ctrl+Shift+X"     Foreground="{StaticResource AccentBrush}"  FontSize="10" FontFamily="Consolas"/>
          <TextBlock Grid.Row="1" Grid.Column="1" Text="Stop audio"       Foreground="{StaticResource TextBrush}"    FontSize="10"/>

          <TextBlock Grid.Row="2" Grid.Column="0" Text="Ctrl+Shift+R"     Foreground="{StaticResource AccentBrush}"  FontSize="10" FontFamily="Consolas"/>
          <TextBlock Grid.Row="2" Grid.Column="1" Text="Replay last"      Foreground="{StaticResource TextBrush}"    FontSize="10"/>

          <TextBlock Grid.Row="3" Grid.Column="0" Text="Ctrl+Alt+T"       Foreground="{StaticResource AccentBrush}"  FontSize="10" FontFamily="Consolas"/>
          <TextBlock Grid.Row="3" Grid.Column="1" Text="Toggle voice on/off" Foreground="{StaticResource TextBrush}" FontSize="10"/>

          <TextBlock Grid.Row="4" Grid.Column="0" Text="Ctrl+Alt+↑"       Foreground="{StaticResource AccentBrush}"  FontSize="10" FontFamily="Consolas"/>
          <TextBlock Grid.Row="4" Grid.Column="1" Text="Speed up"         Foreground="{StaticResource TextBrush}"    FontSize="10"/>

          <TextBlock Grid.Row="5" Grid.Column="0" Text="Ctrl+Alt+↓"       Foreground="{StaticResource AccentBrush}"  FontSize="10" FontFamily="Consolas"/>
          <TextBlock Grid.Row="5" Grid.Column="1" Text="Slow down"        Foreground="{StaticResource TextBrush}"    FontSize="10"/>

          <TextBlock Grid.Row="6" Grid.Column="0" Text="Headset unmute"   Foreground="{StaticResource AccentBrush}"  FontSize="10" FontFamily="Consolas"/>
          <TextBlock Grid.Row="6" Grid.Column="1" Text="Start recording"  Foreground="{StaticResource TextBrush}"    FontSize="10"/>

          <TextBlock Grid.Row="7" Grid.Column="0" Text="Headset mute"     Foreground="{StaticResource AccentBrush}"  FontSize="10" FontFamily="Consolas"/>
          <TextBlock Grid.Row="7" Grid.Column="1" Text="Stop + transcribe" Foreground="{StaticResource TextBrush}"   FontSize="10"/>

          <TextBlock Grid.Row="8" Grid.Column="0" Text="Headset hang-up"  Foreground="{StaticResource AccentBrush}"  FontSize="10" FontFamily="Consolas"/>
          <TextBlock Grid.Row="8" Grid.Column="1" Text="Submit, else stop audio" Foreground="{StaticResource TextBrush}" FontSize="10"/>
        </Grid>

      </StackPanel>
    </Grid>
    </Viewbox>
  </Border>
</Window>
